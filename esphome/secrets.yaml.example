# Fill in the Wi-Fi details. Everything else is pre-generated and can stay.
# This file is gitignored. secrets.yaml.example is the committed template.

wifi_ssid: "CHANGE_ME"
wifi_password: "CHANGE_ME"

# Shared by all radiator nodes. HA prompts for this key when adopting a device.
api_encryption_key: "GENERATE_ME"

# For over-the-air updates after the first USB flash.
ota_password: "GENERATE_ME"

# Password for the fallback hotspot each node raises if Wi-Fi is unreachable.
ap_password: "GENERATE_ME"
